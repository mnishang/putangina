# ------------------------------------------------------------------
# Local environment for Sable & Stem Coffee
# Copy this file to ".env" and fill in your own values.
#   Copy-Item .env.example .env
# The ".env" file is ignored by git — never commit real credentials.
# ------------------------------------------------------------------

# --- Database (MySQL or MariaDB) -----------------------------------
# After installing MySQL Server, create the database once:
#   CREATE DATABASE sable_stem CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Then point this URL at it. URL-encode any special characters in the password
# (for example "@" becomes "%40" and ":" becomes "%3A").
DATABASE_URL=mysql://root:YourPassword@127.0.0.1:3306/sable_stem

# --- Local admin mode (development only) ---------------------------
# A shared secret that lets the admin API (inventory, sales summary) work
# without the Manus OAuth sign-in. Use any long random string.
# ADMIN_API_TOKEN is read by server.mjs; VITE_ADMIN_API_TOKEN is read by the
# React app. They must be exactly the same value.
# Do NOT use this on a public/production deployment.
ADMIN_API_TOKEN=replace-with-a-long-random-string
VITE_ADMIN_API_TOKEN=replace-with-a-long-random-string
